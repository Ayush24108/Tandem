{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Meeting",
  "description": "Meeting record with audio transcript and extracted intelligence",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "project_id": { "type": "string" },
    "title": { "type": "string" },
    "transcript": { "type": "string" },
    "intelligence": { "$ref": "intelligence.json#" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "project_id", "transcript"],
  "additionalProperties": false
}
