{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "description": "Project workspace definition",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "name"],
  "additionalProperties": false
}
